  "fixed_sql": [
    {
      "name": "subjects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"subjects\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color\" INTEGER NOT NULL, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "pdf_files",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pdf_files\" (\"id\" TEXT NOT NULL, \"path\" TEXT NOT NULL, \"page_count\" INTEGER NOT NULL, \"sha256\" TEXT NOT NULL UNIQUE, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "notebooks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"notebooks\" (\"id\" TEXT NOT NULL, \"subject_id\" TEXT NULL REFERENCES subjects (id) ON DELETE SET NULL, \"title\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"pdf_file_id\" TEXT NULL REFERENCES pdf_files (id), \"page_ids\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "pages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pages\" (\"id\" TEXT NOT NULL, \"notebook_id\" TEXT NOT NULL REFERENCES notebooks (id) ON DELETE CASCADE, \"width\" REAL NOT NULL, \"height\" REAL NOT NULL, \"background\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "strokes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"strokes\" (\"id\" TEXT NOT NULL, \"page_id\" TEXT NOT NULL REFERENCES pages (id) ON DELETE CASCADE, \"tool\" TEXT NOT NULL, \"color\" INTEGER NOT NULL, \"size\" REAL NOT NULL, \"points\" BLOB NOT NULL, \"min_x\" REAL NOT NULL, \"min_y\" REAL NOT NULL, \"max_x\" REAL NOT NULL, \"max_y\" REAL NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tapes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tapes\" (\"id\" TEXT NOT NULL, \"page_id\" TEXT NOT NULL REFERENCES pages (id) ON DELETE CASCADE, \"points\" BLOB NOT NULL, \"width\" REAL NOT NULL, \"style\" TEXT NOT NULL DEFAULT 'solid', \"hidden\" INTEGER NOT NULL DEFAULT 1 CHECK (\"hidden\" IN (0, 1)), \"min_x\" REAL NOT NULL, \"min_y\" REAL NOT NULL, \"max_x\" REAL NOT NULL, \"max_y\" REAL NOT NULL, \"study_last_result\" TEXT NULL, \"study_due_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
